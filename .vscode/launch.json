{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mahjong_server (Debug)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/game/Debug/mahjong_server",
      "args": ["--port", "19527", "--seed", "199"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "mahjong_server (Release)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/game/Release/mahjong_server",
      "args": ["--port", "19527", "--seed", "199"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "cmake",
      "request": "launch",
      "name": "CMake: Configure project",
      "cmakeDebugType": "configure",
      "clean": true,
      "configureAll": false,
      "scriptEnv": [
        {
          "name": "CPM_SOURCE_CACHE",
          "value": "${HOME}/.cache/CPM"
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "test_name",
      "type": "pickString",
      "description": "Select test name",
      "options": [
        "mahjong_rules_test",
        "riichi_rules_test",
        "mahjong_classic_game_test",
        "mahjong_riichi_game_test",
        "mahjong_lobby_test",
        "mahjong_async_gate_test"
      ]
    }
  ]
}
