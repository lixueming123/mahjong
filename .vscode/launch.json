{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mahjong_server (Debug)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/game/Debug/mahjong_server",
      "args": ["--port", "19527", "--seed", "199"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "mahjong_server (Release)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/game/Release/mahjong_server",
      "args": ["--port", "19527", "--seed", "199"],
      "cwd": "${workspaceFolder}"
    },
    {
      // Attach to an already running process instead of spawning one. `program` is omitted on
      // purpose: LLDB creates the target from the picked pid, so no path has to be kept in sync
      // with the build directory. Needs the CodeLLDB extension (vadimcn.vscode-lldb); the builtin
      // cpp extension only does syntax highlighting, it has no debugger.
      "name": "Attach to Process",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickProcess}",
      "stopOnEntry": false
    },
    {
      // Incremental: reuses the existing cache in build/, so this is the one to use for the daily
      // "I added a file / touched a CMakeLists" case. "clean": true would throw the cache away and
      // pull every dependency source again — that is the separate entry below.
      "type": "cmake",
      "request": "launch",
      "name": "CMake: Configure (incremental)",
      "cmakeDebugType": "configure",
      "clean": false,
      "configureAll": false,
      "scriptEnv": [
        {
          "name": "CPM_SOURCE_CACHE",
          "value": "${userHome}/.cache/CPM"
        }
      ]
    },
    {
      // Only when the cache itself is suspect (deleted build/, retargeted compiler, ...). Expect
      // this one to take minutes: it re-runs dependency detection from scratch.
      "type": "cmake",
      "request": "launch",
      "name": "CMake: Configure (clean)",
      "cmakeDebugType": "configure",
      "clean": true,
      "configureAll": false,
      "scriptEnv": [
        {
          "name": "CPM_SOURCE_CACHE",
          "value": "${userHome}/.cache/CPM"
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "test_name",
      "type": "pickString",
      "description": "Select test name",
      "options": [
        "mahjong_rules_test",
        "riichi_rules_test",
        "mahjong_classic_game_test",
        "mahjong_riichi_game_test",
        "mahjong_lobby_test",
        "mahjong_async_gate_test"
      ]
    }
  ]
}
